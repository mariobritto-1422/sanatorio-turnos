// ============================================
// SCHEMA PRISMA - Sistema de Gestión de Turnos
// Fase 1: turnos + Fase 2: guardias
// SIN historial clínico (evitar conflictos legales)
// ============================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS — FASE 1
// ============================================

enum Rol {
  PACIENTE
  PROFESIONAL
  RECEPCION
  SUPERADMIN
  ENFERMERO
  MUCAMA
  SUPERVISOR_GUARDIA
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum Genero {
  MASCULINO
  FEMENINO
  OTRO
  NO_ESPECIFICA
}

enum EstadoPaciente {
  ACTIVO
  INACTIVO
}

enum EstadoProfesional {
  ACTIVO
  INACTIVO
}

enum EstadoTurno {
  PENDIENTE
  CONFIRMADO
  EN_CURSO
  COMPLETADO
  CANCELADO_PACIENTE
  CANCELADO_PROFESIONAL
  AUSENTE
}

enum TipoTurno {
  PRIMERA_VEZ
  CONTROL
  URGENCIA
}

enum TipoBloqueo {
  VACACIONES
  LICENCIA
  CONGRESO
  OTRO
}

enum EstadoGenerico {
  ACTIVO
  INACTIVO
}

enum TipoNotificacion {
  CONFIRMACION_TURNO
  RECORDATORIO_24H
  RECORDATORIO_2H
  CANCELACION
}

enum CanalNotificacion {
  EMAIL
  WHATSAPP
  SMS
}

enum EstadoNotificacion {
  PENDIENTE
  ENVIADO
  FALLIDO
  PROGRAMADO
}

// ============================================
// ENUMS — FASE 2: MÓDULO GUARDIAS
// ============================================

enum TipoContrato {
  PLANTA_PERMANENTE
  CONTRATADO
}

enum RolGuardia {
  ENFERMERO
  MUCAMA
}

enum TipoGuardia {
  NORMAL
  EXTRA
  FRANCO
  VACACIONES
  FERIADO
  LICENCIA
}

enum GeneradaPor {
  ALGORITMO
  MANUAL
  CANJE
}

enum EstadoCanje {
  PENDIENTE
  APROBADO
  RECHAZADO
}

enum TipoFeriado {
  NACIONAL
  LOCAL
}

// ============================================
// SANATORIO (multi-tenant mínimo + feature flag)
// ============================================

model Sanatorio {
  id                    String    @id @default(uuid())
  nombre                String
  moduloGuardiasActivo  Boolean   @default(false) @map("modulo_guardias_activo")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  usuarios              Usuario[]
  personalGuardia       PersonalGuardia[]
  configuracionTurnos   ConfiguracionTurnos?
  configuracionSanatorio ConfiguracionSanatorio?
  feriados              Feriado[]

  @@map("sanatorios")
}

// ============================================
// USUARIOS Y AUTENTICACIÓN
// ============================================

model Usuario {
  id                String         @id @default(uuid())
  email             String         @unique
  passwordHash      String         @map("password_hash")
  rol               Rol
  estado            EstadoUsuario  @default(ACTIVO)
  ultimoAcceso      DateTime?      @map("ultimo_acceso")
  tokenRecuperacion String?        @map("token_recuperacion")
  tokenExpiracion   DateTime?      @map("token_expiracion")
  sanatorioId       String?        @map("sanatorio_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  paciente          Paciente?
  profesional       Profesional?
  personalGuardia   PersonalGuardia?
  sanatorio         Sanatorio?     @relation(fields: [sanatorioId], references: [id], onDelete: SetNull)
  turnosCreados     Turno[]        @relation("TurnosCreadosPor")
  turnosCancelados  Turno[]        @relation("TurnosCanceladosPor")
  auditLogs         AuditLog[]
  canjesAprobados   SolicitudCanje[] @relation("CanjesAprobadosPor")

  @@index([sanatorioId])
  @@map("usuarios")
}

// ============================================
// PACIENTES
// ============================================

model Paciente {
  id                          String         @id @default(uuid())
  usuarioId                   String?        @unique @map("usuario_id")
  dni                         String         @unique
  nombre                      String
  apellido                    String
  fechaNacimiento             DateTime       @map("fecha_nacimiento") @db.Date
  genero                      Genero
  telefono                    String
  email                       String?
  direccion                   String?
  localidad                   String?
  provincia                   String?
  obraSocialId                String?        @map("obra_social_id")
  numeroAfiliado              String?        @map("numero_afiliado")
  observacionesMedicas        String?        @map("observaciones_medicas") @db.Text
  estado                      EstadoPaciente @default(ACTIVO)
  familiarResponsableNombre   String?        @map("familiar_responsable_nombre")
  familiarResponsableTelefono String?        @map("familiar_responsable_telefono")
  familiarResponsableRelacion String?        @map("familiar_responsable_relacion")
  createdAt                   DateTime       @default(now()) @map("created_at")
  updatedAt                   DateTime       @updatedAt @map("updated_at")

  usuario    Usuario?   @relation(fields: [usuarioId], references: [id], onDelete: SetNull)
  obraSocial ObraSocial? @relation(fields: [obraSocialId], references: [id], onDelete: SetNull)
  turnos     Turno[]

  @@index([dni])
  @@index([apellido, nombre])
  @@map("pacientes")
}

// ============================================
// PROFESIONALES
// ============================================

model Profesional {
  id                    String             @id @default(uuid())
  usuarioId             String             @unique @map("usuario_id")
  nombre                String
  apellido              String
  matricula             String             @unique
  especialidad          String
  telefono              String?
  email                 String
  duracionTurnoMinutos  Int                @default(30) @map("duracion_turno_minutos")
  colorCalendario       String?            @map("color_calendario")
  aceptaNuevosPacientes Boolean            @default(true) @map("acepta_nuevos_pacientes")
  bio                   String?            @db.Text
  estado                EstadoProfesional  @default(ACTIVO)
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @updatedAt @map("updated_at")

  usuario       Usuario                @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  horarios      HorarioProfesional[]
  bloqueos      BloqueoHorario[]
  turnos        Turno[]
  obrasSociales ProfesionalObraSocial[]

  @@index([matricula])
  @@index([apellido, nombre])
  @@map("profesionales")
}

model HorarioProfesional {
  id            String         @id @default(uuid())
  profesionalId String         @map("profesional_id")
  diaSemana     Int            @map("dia_semana")
  horaInicio    String         @map("hora_inicio")
  horaFin       String         @map("hora_fin")
  estado        EstadoGenerico @default(ACTIVO)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  profesional Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@unique([profesionalId, diaSemana, horaInicio])
  @@index([profesionalId])
  @@map("horarios_profesional")
}

model BloqueoHorario {
  id            String      @id @default(uuid())
  profesionalId String      @map("profesional_id")
  fechaInicio   DateTime    @map("fecha_inicio")
  fechaFin      DateTime    @map("fecha_fin")
  motivo        String?     @db.Text
  tipo          TipoBloqueo
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  profesional Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)

  @@index([profesionalId, fechaInicio, fechaFin])
  @@map("bloqueos_horario")
}

// ============================================
// OBRAS SOCIALES
// ============================================

model ObraSocial {
  id        String         @id @default(uuid())
  nombre    String         @unique
  codigo    String?        @unique
  plan      String?
  telefono  String?
  email     String?
  estado    EstadoGenerico @default(ACTIVO)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  pacientes     Paciente[]
  profesionales ProfesionalObraSocial[]
  turnos        Turno[]

  @@map("obras_sociales")
}

model ProfesionalObraSocial {
  id            String   @id @default(uuid())
  profesionalId String   @map("profesional_id")
  obraSocialId  String   @map("obra_social_id")
  createdAt     DateTime @default(now()) @map("created_at")

  profesional Profesional @relation(fields: [profesionalId], references: [id], onDelete: Cascade)
  obraSocial  ObraSocial  @relation(fields: [obraSocialId], references: [id], onDelete: Cascade)

  @@unique([profesionalId, obraSocialId])
  @@index([profesionalId])
  @@index([obraSocialId])
  @@map("profesionales_obras_sociales")
}

// ============================================
// TURNOS (NÚCLEO FASE 1)
// ============================================

model Turno {
  id                  String      @id @default(uuid())
  pacienteId          String      @map("paciente_id")
  profesionalId       String      @map("profesional_id")
  fechaHora           DateTime    @map("fecha_hora")
  duracionMinutos     Int         @default(30) @map("duracion_minutos")
  estado              EstadoTurno @default(PENDIENTE)
  tipo                TipoTurno   @default(CONTROL)
  motivoConsulta      String?     @map("motivo_consulta") @db.Text
  notaSimple          String?     @map("nota_simple") @db.Text
  obraSocialId        String?     @map("obra_social_id")
  motivoCancelacion   String?     @map("motivo_cancelacion") @db.Text
  canceladoPor        String?     @map("cancelado_por")
  canceladoEn         DateTime?   @map("cancelado_en")
  creadoPor           String      @map("creado_por")
  recordatorioEnviado Boolean     @default(false) @map("recordatorio_enviado")
  createdAt           DateTime    @default(now()) @map("created_at")
  updatedAt           DateTime    @updatedAt @map("updated_at")

  paciente            Paciente  @relation(fields: [pacienteId], references: [id], onDelete: Restrict)
  profesional         Profesional @relation(fields: [profesionalId], references: [id], onDelete: Restrict)
  obraSocial          ObraSocial? @relation(fields: [obraSocialId], references: [id], onDelete: SetNull)
  usuarioCreadoPor    Usuario   @relation("TurnosCreadosPor", fields: [creadoPor], references: [id])
  usuarioCanceladoPor Usuario?  @relation("TurnosCanceladosPor", fields: [canceladoPor], references: [id])

  @@index([profesionalId, fechaHora, estado])
  @@index([pacienteId, fechaHora])
  @@index([fechaHora])
  @@map("turnos")
}

// ============================================
// AUDITORÍA
// ============================================

model AuditLog {
  id              String   @id @default(uuid())
  usuarioId       String?  @map("usuario_id")
  accion          String
  entidadTipo     String?  @map("entidad_tipo")
  entidadId       String?  @map("entidad_id")
  datosAnteriores Json?    @map("datos_anteriores")
  datosNuevos     Json?    @map("datos_nuevos")
  ipAddress       String?  @map("ip_address")
  userAgent       String?  @map("user_agent") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")

  usuario Usuario? @relation(fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId, createdAt])
  @@index([entidadTipo, entidadId])
  @@map("audit_log")
}

// ============================================
// NOTIFICACIONES
// ============================================

model PlantillaNotificacion {
  id        String           @id @default(uuid())
  tipo      TipoNotificacion @unique
  canal     CanalNotificacion
  asunto    String?
  cuerpo    String           @db.Text
  variables String[]         @default([])
  activo    Boolean          @default(true)
  createdAt DateTime         @default(now()) @map("created_at")
  updatedAt DateTime         @updatedAt @map("updated_at")

  @@map("plantillas_notificacion")
}

model ConfiguracionNotificaciones {
  id               String           @id @default(uuid())
  tipoNotificacion TipoNotificacion @map("tipo_notificacion")
  emailActivo      Boolean          @default(true) @map("email_activo")
  whatsappActivo   Boolean          @default(false) @map("whatsapp_activo")
  smsActivo        Boolean          @default(false) @map("sms_activo")
  horaInicioEnvio  String           @default("08:00") @map("hora_inicio_envio")
  horaFinEnvio     String           @default("20:00") @map("hora_fin_envio")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")

  @@unique([tipoNotificacion])
  @@map("configuracion_notificaciones")
}

model Notificacion {
  id              String             @id @default(uuid())
  turnoId         String             @map("turno_id")
  pacienteId      String             @map("paciente_id")
  tipo            TipoNotificacion
  canal           CanalNotificacion
  destinatario    String
  asunto          String?
  mensaje         String             @db.Text
  estado          EstadoNotificacion @default(PENDIENTE)
  intentos        Int                @default(0)
  fechaProgramada DateTime?          @map("fecha_programada")
  fechaEnvio      DateTime?          @map("fecha_envio")
  errorMensaje    String?            @map("error_mensaje") @db.Text
  metadataEnvio   Json?              @map("metadata_envio")
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([turnoId])
  @@index([pacienteId])
  @@index([estado, fechaProgramada])
  @@index([fechaEnvio])
  @@map("notificaciones")
}

// ============================================================
// MÓDULO GUARDIAS — Fase 2
// ============================================================

model PersonalGuardia {
  id                     String       @id @default(uuid())
  usuarioId              String       @unique @map("usuario_id")
  sanatorioId            String       @map("sanatorio_id")
  nombre                 String
  apellido               String
  email                  String
  rol                    RolGuardia
  tipoContrato           TipoContrato @map("tipo_contrato")
  fechaIngreso           DateTime     @map("fecha_ingreso") @db.Date
  horasSemanalesContrato Int          @map("horas_semanales_contrato")
  activo                 Boolean      @default(true)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  usuario          Usuario         @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  sanatorio        Sanatorio       @relation(fields: [sanatorioId], references: [id], onDelete: Cascade)
  guardias         Guardia[]
  bancoHoras       BancoHoras[]
  canjesSolicitados SolicitudCanje[] @relation("CanjesSolicitados")
  canjesRecibidos   SolicitudCanje[] @relation("CanjesRecibidos")

  @@index([sanatorioId, rol])
  @@index([sanatorioId, activo])
  @@map("personal_guardia")
}

model ConfiguracionTurnos {
  id                          String    @id @default(uuid())
  sanatorioId                 String    @unique @map("sanatorio_id")
  turnos                      Json
  maxDiasSeguidosSinFranco    Int       @default(6) @map("max_dias_seguidos_sin_franco")
  maxNochesSeguidasPermitidas Int       @default(3) @map("max_noches_seguidas_permitidas")
  diasFrancoSemanal           Int       @default(2) @map("dias_franco_semanal")
  createdAt                   DateTime  @default(now()) @map("created_at")
  updatedAt                   DateTime  @updatedAt @map("updated_at")

  sanatorio Sanatorio @relation(fields: [sanatorioId], references: [id], onDelete: Cascade)

  @@map("configuracion_turnos")
}

model Guardia {
  id               String      @id @default(uuid())
  personalId       String      @map("personal_id")
  fecha            DateTime    @db.Date
  turnoNombre      String      @map("turno_nombre")
  tipo             TipoGuardia @default(NORMAL)
  horas            Float
  generadaPor      GeneradaPor @default(ALGORITMO) @map("generada_por")
  aprobada         Boolean     @default(false)
  requiereRevision Boolean     @default(false) @map("requiere_revision")
  notas            String?     @db.Text
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  personal      PersonalGuardia  @relation(fields: [personalId], references: [id], onDelete: Cascade)
  canjeOfrecido SolicitudCanje[] @relation("GuardiaOfrecida")
  canjeDeseado  SolicitudCanje[] @relation("GuardiaDeseada")

  @@unique([personalId, fecha, turnoNombre])
  @@index([personalId, fecha])
  @@index([fecha])
  @@map("guardias")
}

model BancoHoras {
  id                 String   @id @default(uuid())
  personalId         String   @map("personal_id")
  mes                Int
  anio               Int      @map("anio")
  horasContrato      Float    @map("horas_contrato")
  horasTrabajadas    Float    @default(0) @map("horas_trabajadas")
  horasExtra         Float    @default(0) @map("horas_extra")
  horasDeuda         Float    @default(0) @map("horas_deuda")
  francosPendientes  Float    @default(0) @map("francos_pendientes")
  findesTrabajados   Int      @default(0) @map("findes_trabajados")
  feriadosTrabajados Int      @default(0) @map("feriados_trabajados")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  personal PersonalGuardia @relation(fields: [personalId], references: [id], onDelete: Cascade)

  @@unique([personalId, mes, anio])
  @@index([personalId])
  @@map("banco_horas")
}

model SolicitudCanje {
  id                String      @id @default(uuid())
  solicitanteId     String      @map("solicitante_id")
  receptorId        String      @map("receptor_id")
  guardiaOfrecidaId String      @map("guardia_ofrecida_id")
  guardiaDeseadaId  String      @map("guardia_deseada_id")
  estado            EstadoCanje @default(PENDIENTE)
  aprobadoPorId     String?     @map("aprobado_por_id")
  motivo            String?     @db.Text
  motivoRechazo     String?     @map("motivo_rechazo") @db.Text
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  solicitante     PersonalGuardia @relation("CanjesSolicitados", fields: [solicitanteId], references: [id], onDelete: Cascade)
  receptor        PersonalGuardia @relation("CanjesRecibidos", fields: [receptorId], references: [id], onDelete: Cascade)
  guardiaOfrecida Guardia         @relation("GuardiaOfrecida", fields: [guardiaOfrecidaId], references: [id], onDelete: Cascade)
  guardiaDeseada  Guardia         @relation("GuardiaDeseada", fields: [guardiaDeseadaId], references: [id], onDelete: Cascade)
  aprobadoPor     Usuario?        @relation("CanjesAprobadosPor", fields: [aprobadoPorId], references: [id], onDelete: SetNull)

  @@index([solicitanteId, estado])
  @@index([receptorId, estado])
  @@map("solicitudes_canje")
}

model Feriado {
  id          String      @id @default(uuid())
  fecha       DateTime    @db.Date
  nombre      String
  tipo        TipoFeriado
  sanatorioId String?     @map("sanatorio_id")
  createdAt   DateTime    @default(now()) @map("created_at")

  sanatorio Sanatorio? @relation(fields: [sanatorioId], references: [id], onDelete: Cascade)

  @@unique([fecha, sanatorioId])
  @@index([fecha])
  @@map("feriados")
}

// ============================================
// CONFIGURACIÓN GENERAL DEL SANATORIO
// ============================================

model ConfiguracionSanatorio {
  id                      String   @id @default(uuid())
  sanatorioId             String   @unique @map("sanatorio_id")
  horarioApertura         String   @default("08:00") @map("horario_apertura")
  horarioCierre           String   @default("20:00") @map("horario_cierre")
  diasAtencion            String   @default("1,2,3,4,5") @map("dias_atencion")
  duracionTurnoDefaultMin Int      @default(30) @map("duracion_turno_default_min")
  telefonoContacto        String?  @map("telefono_contacto")
  emailContacto           String?  @map("email_contacto")
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  sanatorio Sanatorio @relation(fields: [sanatorioId], references: [id], onDelete: Cascade)

  @@map("configuracion_sanatorio")
}
