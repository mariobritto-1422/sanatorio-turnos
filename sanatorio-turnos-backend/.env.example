# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL="postgresql://usuario:password@localhost:5432/sanaturno?schema=public"

# ============================================
# SERVIDOR
# ============================================
PORT=4000
NODE_ENV=development

# ============================================
# JWT
# ============================================
JWT_SECRET=tu-super-secreto-cambiar-en-produccion-minimo-32-caracteres
JWT_EXPIRES_IN=7d

# ============================================
# CORS - Orígenes permitidos (separados por coma)
# Desarrollo: http://localhost:3000
# Producción: https://sanatorio-turnos.netlify.app,https://tu-dominio.com
# ============================================
CORS_ORIGINS=http://localhost:3000

# ============================================
# INSTITUCIÓN - Nombre que aparece en emails y API
# ============================================
NOMBRE_INSTITUCION=Sanaturno

# ============================================
# EMAIL (SMTP) - Sistema de Notificaciones
# Ejemplo con Gmail (habilitar "Contraseñas de aplicación"):
# ============================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="tu-email@gmail.com"
SMTP_PASS="tu-app-password"
EMAIL_FROM="tu-email@gmail.com"
EMAIL_FROM_NAME="Sanaturno"

# ============================================
# TWILIO (WhatsApp / SMS) - Opcional
# Regístrate en: https://www.twilio.com/
# ============================================
TWILIO_ACCOUNT_SID="tu-account-sid"
TWILIO_AUTH_TOKEN="tu-auth-token"
TWILIO_WHATSAPP_NUMBER="+14155238886"
TWILIO_SMS_NUMBER="+1234567890"
