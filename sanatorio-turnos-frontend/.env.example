# ============================================
# API URL - URL del backend
# Desarrollo: http://localhost:4000/api
# Producción: https://sanaturno-backend.onrender.com/api
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# ============================================
# URL de la app frontend (usada en QR de instalación)
# Desarrollo: http://localhost:3000
# Producción: https://sanatorio-turnos.netlify.app
# ============================================
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ============================================
# Nombre de la institución (aparece en sidebars, título y metadata)
# ============================================
NEXT_PUBLIC_NOMBRE_INSTITUCION=Sanaturno
